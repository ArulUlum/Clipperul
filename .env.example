# App
ENV=development
DEBUG=true

# Security — change these in any real deployment. With ENV=production the app refuses to start unless
# both are real secrets (32+ characters, not a default), e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
JWT_SECRET=dev-only-change-me
TOKEN_ENCRYPTION_KEY=dev-only-change-me-too

# Database
DATABASE_URL=postgresql+psycopg://autoclipper:autoclipper@postgres:5432/autoclipper
POSTGRES_USER=autoclipper
POSTGRES_PASSWORD=autoclipper
POSTGRES_DB=autoclipper

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Storage (MinIO in dev)
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=autoclipper
STORAGE_SECRET_KEY=autoclipper123
STORAGE_BUCKET=autoclipper
MINIO_ROOT_USER=autoclipper
MINIO_ROOT_PASSWORD=autoclipper123

# AI providers — set AI_LLM_PROVIDER to openai | anthropic | ollama | gemini, then fill in
# that provider's settings below. Only the selected provider's values are used.
AI_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: use an OpenAI-compatible router/proxy instead of api.openai.com, e.g. a router
# running on the host:
# OPENAI_BASE_URL=http://host.docker.internal:20128/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ollama: run Ollama on the host (not in Docker) and `ollama pull` this model first.
# host.docker.internal lets the backend/worker containers reach it — no API key needed.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
# gemini: get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
WHISPER_MODEL=base

# LLM request handling (every provider). The SDK retries transient failures (timeout, connection error,
# 408/409/429/5xx); 400/401/403/404 are never retried. An empty or malformed reply is asked for again
# LLM_JSON_RETRIES times. A route that rejects response_format=json_object is detected and used without it.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# LLM_JSON_RETRIES=1
# Reserved: visual analysis is not implemented and no image is ever sent to the LLM. Leave it false.
# LLM_VISION_ENABLED=false

# Highlight/clip duration limits (seconds)
MIN_CLIP_DURATION_SECONDS=15
MAX_CLIP_DURATION_SECONDS=180
# The final selection spreads clips across the video: each already-chosen clip within the radius
# (seconds, centre to centre) lowers a candidate's rank by the penalty (score points).
# HIGHLIGHT_DIVERSITY_PENALTY=8
# HIGHLIGHT_DIVERSITY_RADIUS_SECONDS=90

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000

# YouTube OAuth (Phase 3) — create an OAuth client at
# https://console.cloud.google.com/apis/credentials with Authorized redirect URI exactly:
# {BACKEND_BASE_URL}/api/social-accounts/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional: API key for the daily auto-clip to read YouTube's "most popular" charts. Without it,
# the auto-clip uses the access token of a connected YouTube account instead.
YOUTUBE_API_KEY=

# TikTok OAuth (Phase 3) — create an app at https://developers.tiktok.com/ with Login Kit
# enabled, redirect URI exactly: {BACKEND_BASE_URL}/api/social-accounts/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TikTok needs an https:// redirect URI, even in dev. Point this at an ngrok tunnel to :8000 to
# keep BACKEND_BASE_URL on http://localhost:8000 for YouTube. Leave empty to reuse BACKEND_BASE_URL.
TIKTOK_REDIRECT_BASE_URL=

# Instagram OAuth (Phase 3) — create an app at https://developers.facebook.com/ with the
# Instagram product (business login) enabled, redirect URI exactly:
# {BACKEND_BASE_URL}/api/social-accounts/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# (Meta only offers new apps the unified-login setup, which this native adapter doesn't implement —
# use Zernio below for Instagram instead.)

# Zernio (https://zernio.com) — TikTok and Instagram WITHOUT a developer app of your own. Create an
# API key under Dashboard > API Keys. When set, "Connect TikTok / Instagram" opens Zernio's connect
# page and those accounts can publish (the free plan covers the first 2 connected accounts).
# Needs no tunnel or redirect URI registration. Leave empty to disable.
ZERNIO_API_KEY=
# Optional: accounts you already connected in the Zernio dashboard live in its "Default" profile.
# Put that profile's id here and "Connect TikTok / Instagram" imports them instead of asking for new
# connections (which count against the plan's account limit). Shared by every Clipperul user; an
# account belongs to the first user who imports it. Leave empty for one Zernio profile per user.
ZERNIO_PROFILE_ID=
